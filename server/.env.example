# Copy to server/.env and fill in. Never commit .env.
# Real environment variables override values in this file.

PORT=3000
NODE_ENV=development

# Admin login. Store a bcrypt HASH here, never the plaintext password.
ADMIN_USERNAME=admin
# Generate the hash from the server/ folder:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your-password'
# Keep the single quotes around the hash (it contains $ characters).
ADMIN_PASSWORD_HASH=$2b$12$HxXgjdYJHvFc9kvUNUU0Y.yhbMhyw72NO.heLWwmF15GrZYgGx/Za

# Session lifetime in hours (default 12)
SESSION_TTL_HOURS=12

# The session cookie is always HttpOnly + SameSite=Strict. It also gets the Secure flag
# (HTTPS only) when NODE_ENV=production, or when COOKIE_SECURE=true.
COOKIE_SECURE=
